# Database Connection (PostgreSQL or Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/plateflow_dev"

# Admin Authentication
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="sua-senha-super-segura"
# Random secret, at least 32 bytes. Required at boot.
JWT_SECRET="substitua-por-um-segredo-aleatorio-com-32-bytes-ou-mais"

# Same-origin URL of the unified host (comma-separated allowlist). Do not add Vite :5173.
APP_ORIGIN="http://localhost:3005"

# Application URLs & Ports
PORT=3000
API_PORT=3001
WEB_PORT=3000
VITE_API_URL="http://localhost:3001"
APP_URL="http://localhost:3000"
NODE_ENV="development"
